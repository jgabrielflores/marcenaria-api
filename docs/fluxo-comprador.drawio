          <mxGeometry x="547" y="66" width="26" height="26" as="geometry" />
        </mxCell>

        <mxCell id="P1" value="Acessa o site&lt;br&gt;&lt;span style=&apos;font-size:9px;color:#7a7a7a&apos;&gt;Landing Page&amp;nbsp;&amp;nbsp;/&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="420" y="110" width="280" height="52" as="geometry" />
        </mxCell>

        <mxCell id="D1" value="Já possui&lt;br&gt;conta?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="465" y="200" width="190" height="88" as="geometry" />
        </mxCell>

        <!-- ───────── RAMO: CADASTRO + VERIFICAÇÃO (esquerda) ───────── -->
        <mxCell id="R1" value="&lt;b&gt;Cadastro&lt;/b&gt;&amp;nbsp;&amp;nbsp;/register&lt;br&gt;&lt;span style=&apos;font-size:9px;color:#7a7a7a&apos;&gt;Nome · E-mail · Senha (8 a 128 caracteres)&lt;br&gt;Validação: e-mail válido e único&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="40" y="220" width="300" height="76" as="geometry" />
        </mxCell>
        <mxCell id="R2" value="Conta criada com &lt;b&gt;email_verified = false&lt;/b&gt;&lt;br&gt;E-mail de verificação enviado&lt;br&gt;&lt;span style=&apos;font-size:9px;color:#7a7a7a&apos;&gt;link JWT válido por 24 horas&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="40" y="334" width="300" height="70" as="geometry" />
        </mxCell>
        <mxCell id="R3" value="Cliente abre o link de verificação&lt;br&gt;&lt;span style=&apos;font-size:9px;color:#7a7a7a&apos;&gt;GET /auth/verify?token=&amp;lt;JWT&amp;gt;&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="40" y="442" width="300" height="58" as="geometry" />
        </mxCell>
        <mxCell id="DR" value="Link válido e&lt;br&gt;dentro de 24 h?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="80" y="540" width="220" height="92" as="geometry" />
        </mxCell>
        <mxCell id="Rok" value="Conta verificada&lt;br&gt;&lt;span style=&apos;font-size:9px;color:#7a7a7a&apos;&gt;redireciona para /login?verified=1&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="40" y="672" width="300" height="56" as="geometry" />
        </mxCell>
        <mxCell id="Rfail" value="Link inválido ou expirado&lt;br&gt;&lt;span style=&apos;font-size:9px;color:#7a7a7a&apos;&gt;redireciona para /login?verified=0&lt;br&gt;cliente solicita reenvio (máx. 5/min por IP)&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="40" y="772" width="300" height="72" as="geometry" />
        </mxCell>
        <mxCell id="noteSmtp" value="Em desenvolvimento sem SMTP configurado, o link de verificação é impresso no log do backend." style="shape=note;whiteSpace=wrap;html=1;fillColor=#fff8dc;strokeColor=#d6b656;size=14;align=left;verticalAlign=middle;fontSize=10;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="40" y="876" width="300" height="60" as="geometry" />
        </mxCell>

