        <!-- Base: DOCUMENTACAO.md secoes 4 (Autenticacao) e 5 (Fluxo do Comprador) -->

        <mxCell id="title" value="Jornada do Comprador — Ramos Planejados" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=18;fontStyle=1;" vertex="1" parent="1">
