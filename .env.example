# =============================================================
# DATABASE
# Format: postgresql://user:password@host:port/database_name
# =============================================================
DATABASE_URL=postgresql://user:password@localhost:5432/marcenaria_dev

# =============================================================
# JWT — Authentication
# SECRET_KEY: random string, minimum 32 characters
#   Generate one with: python3 -c "import secrets; print(secrets.token_hex(32))"
# ALGORITHM: signing algorithm — keep HS256
# ACCESS_TOKEN_EXPIRE_MINUTES: 1440 = 24 hours
# =============================================================
SECRET_KEY=your-secret-key-minimum-32-characters-here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# =============================================================
# ADMIN SEED
# Credentials for the first admin user (created by migration seed)
# =============================================================
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=your-admin-password

# =============================================================
# RUNTIME ENVIRONMENT
# development: plain-text logs (human-readable)
# production:  JSON logs (machine-readable, default)
# =============================================================
ENV=development

# =============================================================
# CORS — Frontend origin allowed to call this API
# Development: http://localhost:3000 (Next.js dev server)
# Production:  https://your-app.vercel.app
# =============================================================
FRONTEND_ORIGIN=http://localhost:3000

# =============================================================
# API base URL — used to build e-mail verification links
# Development: http://localhost:8000
# Production:  https://your-api-domain
# =============================================================
API_BASE_URL=http://localhost:8000

# =============================================================
# E-MAIL (Brevo transactional API)
# Railway blocks outbound SMTP ports, so e-mail is sent over HTTPS
# through Brevo's API instead of SMTP.
# Leave BREVO_API_KEY empty in development: the verification link is
# logged to the server output instead of being sent.
# Production: create a key at brevo.com (Settings -> SMTP & API ->
# API Keys) and verify EMAIL_FROM as a sender first.
# =============================================================
BREVO_API_KEY=
EMAIL_FROM=
EMAIL_FROM_NAME=Ramos Planejados
